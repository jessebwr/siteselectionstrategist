---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactBand from '../components/ContactBand.astro';
import PageHero from '../components/PageHero.astro';
import { asset } from '../utils/paths';
---

<BaseLayout title="About">
  <PageHero eyebrow="Who We Are" title="About Us" image="assets/about-core.jpg" compact />

  <section class="section about-section">
    <div class="container intro-grid">
      <div class="reveal">
        <p class="eyebrow">Core Competence</p>
        <h1 class="section-heading">Hotel Site Selection Partner</h1>
      </div>
      <div class="reveal">
        <p>
          SiteSelectionStrategist LLC is the meeting planner&rsquo;s conference
          venue site selection partner advocate from the moment of inception
          through the conclusion of a program.
        </p>
        <p>
          From intimate meetings of ten people to large-scale incentive programs
          or convention for thousands, globally, SiteSelectionStrategist LLC is
          your ValuePlus and FeeFree site selection ally.
        </p>
        <p>
          We are the conduit between client and hotel in a very collaborative
          process with the singular focus of positioning a program to be the
          best it can possibly be at the most suitable venue with the best
          values and most favorable terms.
        </p>
        <p>
          We handle all the time-intensive details involved in hotel site
          selection, a welcome fee-free service to meeting planners who are
          increasingly burdened with the strain of diminishing budgets and
          staffing and competition for space availability in a seller&rsquo;s
          market.
        </p>
      </div>
    </div>
    <div class="container values-grid">
      {[
        {
          heading: 'Strategic',
          copy: 'We leverage industry knowledge, market intelligence, and established hotel relationships to identify the right properties and negotiate competitive rates, concessions, and favorable contract terms.',
        },
        {
          heading: 'Professional',
          copy: 'We bring decades of hospitality experience, meticulous attention to detail, and a thorough understanding of hotel operations to every stage of the site selection and contracting process.',
        },
        {
          heading: 'Loyal',
          copy: 'Our loyalty is to our clients. We represent their interests exclusively, advocate for their priorities, and negotiate agreements that protect their investment and support their program\u2019s success.',
        },
      ].map((item) => (
        <article class="value-card reveal">
          <h2>{item.heading}</h2>
          <p>{item.copy}</p>
        </article>
      ))}
    </div>
    <div class="container about-image reveal">
      <img src={asset('assets/process-site-search.jpg')} alt="Hotel site search meeting" />
    </div>
  </section>

  <ContactBand />
</BaseLayout>

<style>
  .about-section {
    background: #fff;
  }

  .intro-grid {
    display: grid;
    grid-template-columns: 0.82fr 1.18fr;
    gap: clamp(36px, 7vw, 86px);
    align-items: start;
  }

  .intro-grid p:not(.eyebrow) {
    margin: 0 0 20px;
    color: #666;
    letter-spacing: 0.02em;
    line-height: 2;
  }

  .values-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: -4px;
    transform: translateY(48px);
    box-shadow: 0 18px 70px rgba(0, 0, 0, 0.08);
  }

  .value-card {
    min-height: 210px;
    border-right: 1px solid #eee;
    background: #fff;
    padding: 38px;
  }

  .value-card:last-child {
    border-right: 0;
  }

  h2 {
    margin: 0 0 12px;
    color: #555;
    font-size: 1rem;
    font-weight: 900;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .value-card p {
    margin: 0;
    color: #777;
    font-size: 0.95rem;
  }

  .about-image {
    margin-top: 104px;
  }

  .about-image img {
    width: min(640px, 100%);
    margin-left: auto;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.2);
  }

  @media (max-width: 860px) {
    .intro-grid,
    .values-grid {
      grid-template-columns: 1fr;
    }

    .values-grid {
      transform: none;
      margin-top: 42px;
    }

    .value-card {
      border-right: 0;
      border-bottom: 1px solid #eee;
    }

    .about-image {
      margin-top: 46px;
    }
  }
</style>
